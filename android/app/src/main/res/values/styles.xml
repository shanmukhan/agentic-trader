<resources>
    <style name="Theme.AgenticTrader.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F4F7F9</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.AgenticTrader</item>
    </style>
    <style name="Theme.AgenticTrader" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#F4F7F9</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">#18776D</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
