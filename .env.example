# Copy to .env, chmod 600 .env, then source it explicitly. Never commit .env.
TRADING_MODE=paper
TRADING_CONFIG=config/paper.toml
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
TRADING_OPERATOR_TOKEN=
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Optional reviewed data/strategy profile; see docs/trading-desk.md.
TRADING_ANALYSIS_PROFILE=
# Optional independently validated model for UI-prepared history, matching this account/horizon.
# Leave blank for an explicitly selected experimental rules-only paper policy.
TRADING_PREPARATION_MODEL=
