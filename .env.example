# Copy to .env, chmod 600 .env, then source it explicitly. Never commit .env.
TRADING_MODE=paper
TRADING_CONFIG=config/paper.toml
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Pi: sync_operator_token.py USER@PI --generate creates/saves a strong token privately.
# At least 32 characters; a short password prevents service startup.
TRADING_OPERATOR_TOKEN=
# Optional exact HTTPS reverse-proxy origin and one URL prefix (Pi public profile).
# Leave empty for local-only operation. Never use wildcard hosts/origins.
TRADING_PUBLIC_ORIGIN=
TRADING_PUBLIC_PATH=
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Optional reviewed data/strategy profile; see docs/trading-desk.md.
TRADING_ANALYSIS_PROFILE=
# Optional independently validated model for UI-prepared history, matching this account/horizon.
# Leave blank for an explicitly selected experimental rules-only paper policy.
TRADING_PREPARATION_MODEL=
