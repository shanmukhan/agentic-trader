<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.trading-operations</string>
  <key>ProgramArguments</key><array>
    <string>/bin/sh</string>
    <string>/ABSOLUTE/PATH/agentic-trader/scripts/start_operations.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/agentic-trader</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/agentic-trader/logs/operations.err</string>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/agentic-trader/logs/operations.out</string>
</dict></plist>
