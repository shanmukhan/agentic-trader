[Unit]
Description=Independent paper operations monitor (local alerts, no trading authority)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=trading-agent
Group=trading-agent
WorkingDirectory=/opt/agentic-trader
EnvironmentFile=/etc/agentic-trader.env
ExecStart=/opt/agentic-trader/.venv/bin/trading-agent operations-watch --output /opt/agentic-trader/data/operations-watch
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/agentic-trader/data /opt/agentic-trader/logs
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
